{
  "name": "endaxis-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "convert:legacy-timeline": "node --experimental-strip-types tools/legacy-timeline/cli.ts",
    "pretype-check": "node --experimental-strip-types tools/inspector-schema/prepare.ts",
    "build": "vite build",
    "preview": "vite preview",
    "export:game-icons": "node --experimental-strip-types tools/game-data-compiler/scripts/exportReferencedGameIcons.ts",
    "export:game-locales": "python tools/game-data-compiler/scripts/exportGameLocales.py",
    "type-check": "vue-tsc --noEmit --project tsconfig.app.json --incremental false",
    "type-check:game-data-contract": "tsc --project packages/game-data-contract/tsconfig.json",
    "type-check:game-data-production": "tsc --project tools/game-data-compiler/tsconfig.production.json",
    "type-check:game-data": "tsc --project tools/game-data-compiler/tsconfig.json",
    "test": "vitest run src",
    "test:game-data": "vitest run tools/game-data-compiler",
    "test:tools": "vitest run tools/legacy-timeline tools/inspector-schema",
    "type-check:tools": "tsc -p tsconfig.node.json && tsc -p tools/legacy-timeline/tsconfig.json && tsc -p tools/inspector-schema/tsconfig.json && tsc -p tools/performance/tsconfig.json",
    "audit:game-data:operators": "node --experimental-strip-types tools/game-data-compiler/scripts/auditOperatorSourceClosures.ts",
    "audit:game-data:operator-active-skills": "node --experimental-strip-types tools/game-data-compiler/scripts/auditOperatorActiveSkillMigration.ts",
    "audit:game-data:operator-runtime-templates": "node --experimental-strip-types tools/game-data-compiler/scripts/auditOperatorRuntimeTemplates.ts",
    "audit:game-data:candidate-operator-skills": "node --experimental-strip-types tools/game-data-compiler/scripts/auditCandidateOperatorSkills.ts",
    "audit:game-data:candidate-equipment": "node --experimental-strip-types tools/game-data-compiler/scripts/auditCandidateEquipment.ts",
    "audit:game-data:generated-operator-structure": "node --experimental-strip-types tools/game-data-compiler/scripts/auditGeneratedOperatorStructure.ts",
    "audit:game-data:tag-references": "node --experimental-strip-types tools/game-data-compiler/scripts/auditGameplayTagReferences.ts",
    "audit:game-data:weapons": "node --experimental-strip-types tools/game-data-compiler/scripts/auditWeaponStaticDefinitions.ts",
    "audit:game-data:gear-set-sources": "node --experimental-strip-types tools/game-data-compiler/scripts/auditGearSetSourceClosure.ts",
    "audit:game-data:gear-set-static": "node --experimental-strip-types tools/game-data-compiler/scripts/auditGearSetStaticDefinitions.ts",
    "generate:game-data:weapons": "node --experimental-strip-types tools/game-data-compiler/scripts/generateWeaponDefinitions.ts",
    "generate:game-data:gears": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGearDefinitions.ts",
    "generate:game-data:gear-sets": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGearSetDefinitions.ts",
    "generate:game-data:operator-active-skill": "node --experimental-strip-types tools/game-data-compiler/scripts/generateOperatorActiveSkillRuntime.ts",
    "generate:game-data:operator-active-skills": "node --experimental-strip-types tools/game-data-compiler/scripts/generateOperatorActiveSkillRuntimeBatch.ts",
    "generate:game-data:operator-passive-ui": "node --experimental-strip-types tools/game-data-compiler/scripts/generateOperatorPassiveUiPrefabCatalog.ts",
    "generate:game-data:common-buffs": "node --experimental-strip-types tools/game-data-compiler/scripts/generateCommonBuffDefinitions.ts",
    "generate:game-data:consumables": "node --experimental-strip-types tools/game-data-compiler/scripts/generateConsumableDefinitions.ts",
    "plan:game-data:operator-unity-templates": "node --experimental-strip-types tools/game-data-compiler/scripts/planOperatorUnityTemplates.ts",
    "download:game-data:sources": "node --experimental-strip-types tools/game-data-compiler/scripts/downloadGameDataSources.ts",
    "extract:game-data:enemy-ranks": "node --experimental-strip-types tools/game-data-compiler/scripts/extractEnemyRankEvidence.ts",
    "generate:game-data:enemies": "node --experimental-strip-types tools/game-data-compiler/scripts/generateEnemyDefinitions.ts",
    "audit:game-data:enemies": "node --experimental-strip-types tools/game-data-compiler/scripts/auditCandidateEnemyDefinitions.ts",
    "rebuild:game-data": "node --experimental-strip-types tools/game-data-compiler/scripts/rebuildGameData.ts",
    "generate:game-data:gameplay-tags": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGameplayTagCatalog.ts",
    "generate:game-data:tag-predefine": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGameplayTagPredefine.ts",
    "generate:game-data:hit-stop-curves": "node --experimental-strip-types tools/game-data-compiler/scripts/generateHitStopCurveCatalog.ts",
    "generate:game-data:time-dilation": "node --experimental-strip-types tools/game-data-compiler/scripts/generateTimeDilationCatalog.ts",
    "generate:game-data:battle-command-mapping": "node --experimental-strip-types tools/game-data-compiler/scripts/generateBattleCommandMappingCatalog.ts",
    "generate:game-data:movement-setting": "node --experimental-strip-types tools/game-data-compiler/scripts/generateMovementSettingCatalog.ts",
    "generate:game-data:dash-energy": "node --experimental-strip-types tools/game-data-compiler/scripts/generateDashEnergyConfig.ts",
    "generate:game-data:skill-setting": "node --experimental-strip-types tools/game-data-compiler/scripts/generateSkillSettingCatalog.ts",
    "generate:game-data:global-buffs": "node --experimental-strip-types tools/game-data-compiler/scripts/generateGlobalBuffCatalog.ts",
    "generate:game-data:contingency-contract": "node --experimental-strip-types tools/game-data-compiler/scripts/generateContingencyContractLocales.ts",
    "generate:game-data:contingency-contract-definitions": "node --experimental-strip-types tools/game-data-compiler/scripts/generateContingencyContractDefinitions.ts",
    "bench": "vitest bench --run src/benchmarks",
    "verify:real-timeline-checkpoints": "node --experimental-strip-types tools/performance/verify-real-timeline-checkpoints.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@vueuse/core": "^14.1.0",
    "@zumer/snapdom": "^2.0.1",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.22",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.6.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.5",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "^4.0.17",
    "vue-tsc": "^3.2.2"
  },
  "lint-staged": {
    "*.{js,ts,vue,json,jsonc,css,scss,html,md}": "prettier --write"
  }
}

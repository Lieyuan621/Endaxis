{
  "name": "endaxis-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Endaxis desktop application",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node app/launch.cjs",
    "test": "node --test app/*.test.cjs features/overlay/main/*.test.cjs",
    "install:runtime": "install-electron",
    "prepackage": "npm run install:runtime",
    "prepackage:dir": "npm run install:runtime",
    "package": "electron-builder --config build/electron-builder.json --win zip --x64 --publish never",
    "package:dir": "electron-builder --config build/electron-builder.json --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  }
}
